[sub_resource type="GDScript" id="GDScript_gs5k1"]
script/source = "extends Node2D

# ---- 对外接口：一次性返回随机的生成信息（位置 + 方向）----
func get_random_spawn_info() -> Dictionary:
	var spawn_areas := get_tree().get_nodes_in_group(\"spawn_areas\")
	if spawn_areas.is_empty():
		return {}   # 没有生成点，返回空字典（调用方需判断）

	var chosen_area: Area2D = spawn_areas[randi() % spawn_areas.size()]

	return {
		\"position\": _get_random_point_in_area(chosen_area),
		\"direction\": chosen_area.spawn_direction,
	}

# ---- 内部辅助：在指定 Area 内随机取一个世界坐标点 ----
func _get_random_point_in_area(area: Area2D) -> Vector2:
	var collision_shape: CollisionShape2D = null
	for child in area.get_children():
		if child is CollisionShape2D:
			collision_shape = child
			break

	var shape: RectangleShape2D = collision_shape.shape
	var half: Vector2 = shape.size / 2.0
	var offset := Vector2(randf_range(-half.x, half.x), randf_range(-half.y, half.y))
	return collision_shape.global_position + offset
"

